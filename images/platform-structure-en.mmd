flowchart TB
    subgraph entry["Research entry points"]
        direction LR
        chat["Natural-language chat<br/>Ask a research question"]
        plaza["Research plaza<br/>Explore published research"]
        skills["Research Skills<br/>Choose a research method"]
    end
    subgraph core["Core capabilities"]
        direction LR
        research["Research and analysis<br/>Companies, sectors and markets"]
        desk["Research desks<br/>Build thematic dashboards"]
        strategy["Strategy development<br/>Selection, timing and backtests"]
        monitor["Monitoring and review<br/>Signals and scheduled research"]
    end
    subgraph base["Research foundations"]
        direction LR
        db["Multi-market database<br/>China A-shares, Hong Kong, US, ETFs and funds"]
        kb["Research knowledge base<br/>Company, sector and market context"]
        sandbox["Sandbox<br/>Research execution environment"]
    end
    workspace["VicAlpha · AI research workspace<br/>Frame hypotheses, organize evidence and test strategies"]
    chat --> workspace
    plaza --> workspace
    skills --> workspace
    workspace --> core
    base -.-> core
    style entry fill:#ffffff,stroke:#bdcddd
    style workspace fill:#f1f6fb,stroke:#7691ac
    style core fill:#eef5fc,stroke:#3c78bf
    style base fill:#f7f9fb,stroke:#98aabf,stroke-dasharray: 7 5
